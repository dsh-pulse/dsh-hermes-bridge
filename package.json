  "files": [
    "lib",
    "cordis.yml",
    "README.md"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "wechat",
    "hermes-agent",
    "notify",
    "bridge",
    "cordis",
    "ai-agent"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dsh-pulse/dsh-hermes-bridge.git"
  },
  "homepage": "https://github.com/dsh-pulse/dsh-hermes-bridge#readme",
  "bugs": {
    "url": "https://github.com/dsh-pulse/dsh-hermes-bridge/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.yml"
    }
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  }
}
